---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../data/site';
import { PRODUCTS } from '../data/products';
---

<BaseLayout
  title={`راهنمای نصب و حریم خصوصی | ${SITE_CONFIG.brandName}`}
  description="راهنمای نصب افزونه‌های مدیر پلاس روی مرورگرهای کروم، اج و فایرفاکس همراه با اصول حفظ حریم خصوصی مدارس"
>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-foreground">راهنمای نصب و حریم خصوصی</h1>
    <p class="mt-3 text-base leading-relaxed text-muted-foreground">
      این مسیر در فاز ۴ با راهنمای تصویری مرورگرها و پاسخ کامل به پرسش‌های امنیتی مدیران مدارس تکمیل می‌شود.
    </p>

    <div class="mt-8 space-y-4">
      {PRODUCTS.map((product) => (
        <div class="rounded-2xl border border-border bg-card p-6">
          <h2 class="text-lg font-bold text-foreground">{product.name}</h2>
          <p class="mt-1 text-sm text-muted-foreground">{product.shortTagline}</p>
          <p class="mt-3 text-xs text-muted-foreground">
            ربات فعال‌سازی بله:{' '}
            <a href={product.baleBotUrl} target="_blank" rel="noopener noreferrer" class="font-mono text-primary hover:underline" dir="ltr">
              {product.baleBotHandle}
            </a>
          </p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
