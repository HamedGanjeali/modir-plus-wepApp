---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroProductGateway from '../components/landing/HeroProductGateway.astro';
import TrustBar from '../components/landing/TrustBar.astro';
import { SITE_CONFIG } from '../data/site';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_CONFIG.brandName,
  alternateName: SITE_CONFIG.brandNameEn,
  url: SITE_CONFIG.siteUrl,
  description: SITE_CONFIG.heroDescription,
  sameAs: [SITE_CONFIG.eitaaHub.url],
};
---

<BaseLayout jsonLd={[organizationSchema]}>
  <HeroProductGateway />
  <TrustBar />
</BaseLayout>
