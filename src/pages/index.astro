---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../data/site';
import { PRODUCTS } from '../data/products';
---

<BaseLayout>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-success/30 bg-success/10 px-3.5 py-1 text-xs font-semibold text-success">
        {SITE_CONFIG.trialPolicy.badgeLabel}
      </span>
      <h1 class="mt-5 text-3xl font-extrabold leading-tight text-foreground sm:text-5xl text-balance">
        {SITE_CONFIG.brandName} — {SITE_CONFIG.tagline}
      </h1>
      <p class="mt-4 max-w-prose text-base leading-relaxed text-muted-foreground text-pretty">
        {SITE_CONFIG.heroDescription}
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {PRODUCTS.map((product) => (
        <article class="flex flex-col justify-between rounded-3xl border border-border bg-card p-7 shadow-sm transition-colors hover:border-primary/40">
          <div>
            <div class="flex items-center justify-between gap-3">
              <span class="rounded-full bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">
                نسخه {product.version}
              </span>
              <span class="text-xs font-medium text-primary">{product.categoryLabel}</span>
            </div>
            <h2
              transition:name={`product-title-${product.slug}`}
              class="mt-4 text-2xl font-bold text-foreground"
            >
              {product.name}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              {product.shortTagline}
            </p>
            <ul class="mt-5 space-y-2 text-sm text-foreground/90">
              {product.highlights.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-3 border-t border-border pt-5">
            <a
              href={`/products/${product.slug}`}
              class="inline-flex items-center justify-center rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
            >
              بررسی کامل، تصاویر و دانلود
            </a>
            <a
              href={product.baleBotUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted"
            >
              تست رایگان در بله
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
