---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductHero from '../../components/product/ProductHero.astro';
import BeforeAfterSection from '../../components/product/BeforeAfterSection.astro';
import { WorkflowScenarioTabs } from '../../components/product/WorkflowScenarioTabs';
import { ProductLightboxGallery } from '../../components/product/ProductLightboxGallery';
import { BrowserInstallBox } from '../../components/product/BrowserInstallBox';
import EitaaTutorialsSection from '../../components/product/EitaaTutorialsSection.astro';
import { FaqAccordion } from '../../components/FaqAccordion';
import { PRODUCTS, getProductBySlug } from '../../data/products';
import { SITE_CONFIG } from '../../data/site';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug ?? '');

if (!product) {
  throw new Error(`Product not found for slug: ${slug}`);
}

const productUrl = new URL(`/products/${product.slug}/`, SITE_CONFIG.siteUrl).toString();

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  alternateName: product.nameEn,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Windows, macOS, Linux (Chrome, Edge, Firefox)',
  softwareVersion: product.version,
  description: product.heroSummary,
  url: productUrl,
  publisher: {
    '@type': 'Organization',
    name: SITE_CONFIG.brandName,
    url: SITE_CONFIG.siteUrl,
  },
  offers: {
    '@type': 'Offer',
    description: SITE_CONFIG.trialPolicy.badgeLabel,
    url: product.baleBotUrl,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: product.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title={`${product.name} | ${SITE_CONFIG.brandName}`}
  description={product.heroSummary}
  ogImage={`/og/${product.slug}-og.svg`}
  jsonLd={[softwareSchema, faqSchema]}
>
  <ProductHero product={product} />

  <BeforeAfterSection product={product} />

  <section
    id="scenarios"
    class="scroll-mt-24 border-y border-border/80 bg-muted/35 py-12 lg:py-14"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <span class="inline-flex items-center rounded-full border border-primary/25 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
          جریان کار واقعی بر اساس نقش
        </span>
        <h2 class="mt-2.5 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl text-balance">
          ماژول‌ها و سناریوهای اجرایی در {product.name}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground text-pretty">
          هر ماژول متناسب با وظایف واقعی مدیر، معاونین، دبیران و اولیا طراحی شده است.
        </p>
      </div>

      <div class="mt-7">
        <WorkflowScenarioTabs
          productName={product.name}
          accentTone={product.accentTone}
          useCases={product.useCases}
          client:visible
        />
      </div>
    </div>
  </section>

  <section id="gallery" class="scroll-mt-24 mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
    <div class="max-w-2xl">
      <span class="inline-flex items-center rounded-full border border-primary/25 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
        نمای واقعی محیط کار
      </span>
      <h2 class="mt-2.5 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl text-balance">
        گالری بخش‌های کلیدی {product.name}
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground text-pretty">
        برای بررسی جزئیات بیشتر، روی هر نما کلیک کنید یا با کلیدهای جهت‌نما بین صفحات جابه‌جا شوید.
      </p>
    </div>

    <div class="mt-7">
      <ProductLightboxGallery
        productName={product.name}
        accentTone={product.accentTone}
        items={product.galleryItems}
        client:visible
      />
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-14 sm:px-6 lg:px-8">
    <section id="install-box" class="scroll-mt-24 pt-2">
      <div class="mb-6 max-w-2xl">
        <span class="inline-flex items-center rounded-full border border-success/30 bg-success/10 px-3 py-1 text-xs font-semibold text-success">
          نصب و شروع دوره آزمایشی
        </span>
        <h2 class="mt-2.5 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl text-balance">
          نصب {product.name} و فعال‌سازی ۱۰ روز تست رایگان
        </h2>
      </div>

      <BrowserInstallBox
        productName={product.name}
        accentTone={product.accentTone}
        installTargets={product.installTargets}
        installVideoUrl={product.installVideoUrl}
        installVideoDuration={product.installVideoDuration}
        externalPortals={product.externalPortals}
        baleBotHandle={product.baleBotHandle}
        baleBotUrl={product.baleBotUrl}
        trialBadgeLabel={SITE_CONFIG.trialPolicy.badgeLabel}
        trialSummary={SITE_CONFIG.trialPolicy.summary}
        client:visible
      />
    </section>
  </section>

  <EitaaTutorialsSection product={product} />

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-4">
        <span class="text-xs font-semibold text-primary">پاسخ به سوالات رایج</span>
        <h2 class="mt-1.5 text-2xl font-extrabold text-foreground text-balance">
          سوالات متداول {product.name}
        </h2>
        <p class="mt-2 text-sm leading-[1.8] text-muted-foreground text-pretty">
          برای مطالعه کامل اصول نگهداری داده‌ها و راهنمای تصویری نصب مرورگرها، صفحه راهنما را ببینید.
        </p>
        <a
          href="/guide"
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded"
        >
          <span>راهنمای نصب و حریم خصوصی</span>
          <svg class="h-4 w-4 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <div class="lg:col-span-8">
        <FaqAccordion items={product.faqs} client:visible />
      </div>
    </div>
  </section>
</BaseLayout>
