---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductHero from '../../components/product/ProductHero.astro';
import BeforeAfterSection from '../../components/product/BeforeAfterSection.astro';
import { WorkflowScenarioTabs } from '../../components/product/WorkflowScenarioTabs';
import { PRODUCTS, getProductBySlug } from '../../data/products';
import { SITE_CONFIG } from '../../data/site';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug ?? '');

if (!product) {
  throw new Error(`Product not found for slug: ${slug}`);
}
---

<BaseLayout
  title={`${product.name} | ${SITE_CONFIG.brandName}`}
  description={product.heroSummary}
>
  <ProductHero product={product} />

  <BeforeAfterSection product={product} />

  <section
    id="scenarios"
    class="scroll-mt-24 border-y border-border/80 bg-muted/35 py-12 lg:py-14"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <span class="inline-flex items-center rounded-full border border-primary/25 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
          جریان کار واقعی بر اساس نقش
        </span>
        <h2 class="mt-2.5 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl text-balance">
          ماژول‌ها و سناریوهای اجرایی در {product.name}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground text-pretty">
          هر ماژول متناسب با وظایف واقعی مدیر، معاونین، دبیران و اولیا طراحی شده است.
        </p>
      </div>

      <div class="mt-7">
        <WorkflowScenarioTabs
          productName={product.name}
          accentTone={product.accentTone}
          useCases={product.useCases}
          client:visible
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <div id="gallery" class="scroll-mt-24 card-surface rounded-2xl border border-border bg-card p-6">
        <h2 class="text-lg font-bold text-foreground">پیش‌نمایش‌های آماده تکمیل در گام‌های بعدی فاز ۳</h2>
        <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
          {product.galleryItems.map((item) => (
            <li>
              <span class="font-semibold text-foreground">{item.title}:</span> {item.caption}
            </li>
          ))}
        </ul>
      </div>

      <div id="eitaa-tutorials" class="scroll-mt-24 card-surface rounded-2xl border border-border bg-card p-6">
        <h2 class="text-lg font-bold text-foreground">فهرست آموزش‌های لقمه‌ای در ایتا</h2>
        <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
          {product.tutorials.map((tut) => (
            <li>
              <span class="font-medium text-foreground">{tut.title}</span>
              {' '}(<span class="tabular-nums">{tut.duration}</span>) —{' '}
              <span dir="ltr" class="inline-block font-mono text-xs text-primary">{tut.hashtag}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div id="install-box" class="scroll-mt-24 card-surface mt-6 rounded-2xl border border-border bg-card p-6">
      <h2 class="text-lg font-bold text-foreground">کادر نصب مرورگر و فعال‌سازی در بله</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        {SITE_CONFIG.trialPolicy.summary}
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        {product.installTargets.map((target) => (
          <a
            href={target.installUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-border bg-background px-4 py-2 text-xs font-semibold text-foreground transition-colors hover:border-primary/45 hover:bg-muted"
          >
            {target.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
