---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCTS, getProductBySlug } from '../../data/products';
import { SITE_CONFIG } from '../../data/site';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug ?? '');

if (!product) {
  throw new Error(`Product not found for slug: ${slug}`);
}
---

<BaseLayout
  title={`${product.name} | ${SITE_CONFIG.brandName}`}
  description={product.heroSummary}
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <nav aria-label="مسیر صفحه" class="text-xs text-muted-foreground">
      <a href="/" class="hover:text-primary">خانه</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">{product.name}</span>
    </nav>

    <div class="mt-6 rounded-3xl border border-border bg-card p-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
          نسخه {product.version}
        </span>
        <span class="rounded-full bg-success/10 px-3 py-1 text-xs font-semibold text-success">
          {SITE_CONFIG.trialPolicy.badgeLabel}
        </span>
      </div>

      <h1
        transition:name={`product-title-${product.slug}`}
        class="mt-4 text-3xl font-extrabold text-foreground sm:text-4xl"
      >
        {product.name}
      </h1>
      <p class="mt-3 max-w-prose text-base leading-relaxed text-muted-foreground">
        {product.heroSummary}
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={product.baleBotUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground"
        >
          شروع ۱۰ روز تست رایگان ({product.baleBotHandle})
        </a>
        <a
          href={SITE_CONFIG.eitaaHub.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-xl border border-border bg-background px-5 py-2.5 text-sm font-medium text-foreground"
        >
          ویدیوهای آموزشی در ایتا ({product.eitaaProductHashtag})
        </a>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-border bg-card p-6">
        <h2 class="text-lg font-bold text-foreground">پیش‌نمایش‌های آماده تکمیل در فاز ۳</h2>
        <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
          {product.galleryItems.map((item) => (
            <li>{item.title} — {item.caption}</li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-border bg-card p-6">
        <h2 class="text-lg font-bold text-foreground">فهرست آموزش‌های لقمه‌ای در ایتا</h2>
        <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
          {product.tutorials.map((tut) => (
            <li>
              <span class="font-medium text-foreground">{tut.title}</span>
              {' '}({tut.duration}) — <span dir="ltr" class="inline-block">{tut.hashtag}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
