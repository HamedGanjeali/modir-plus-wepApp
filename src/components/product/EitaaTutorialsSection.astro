---
import type { ProductDefinition } from '../../data/products';
import { SITE_CONFIG } from '../../data/site';

interface Props {
  product: ProductDefinition;
}

const { product } = Astro.props;
const isPrimary = product.accentTone === 'primary';
---

<section
  id="eitaa-tutorials"
  class="scroll-mt-24 border-y border-border/80 bg-muted/35 py-12 lg:py-14"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="card-surface flex flex-col justify-between gap-5 rounded-3xl border border-border bg-card p-6 sm:flex-row sm:items-center">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span
            class:list={[
              'rounded-full px-3 py-1 text-xs font-semibold',
              isPrimary ? 'bg-primary/10 text-primary' : 'bg-success/10 text-success',
            ]}
          >
            آموزش‌های لقمه‌ای ۳۰ تا ۶۰ ثانیه‌ای
          </span>
          <span dir="ltr" class="inline-block rounded-full bg-muted px-2.5 py-1 font-mono text-xs text-muted-foreground">
            {SITE_CONFIG.eitaaHub.handle}
          </span>
          <span dir="ltr" class="inline-block rounded-full bg-muted px-2.5 py-1 font-mono text-xs text-primary">
            {product.eitaaProductHashtag}
          </span>
        </div>

        <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl text-balance">
          آموزش‌های ویدیویی {product.name} در {SITE_CONFIG.eitaaHub.name}
        </h2>
        <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted-foreground text-pretty">
          هر قابلیت در یک ویدیوی کوتاه و کاربردی آموزش داده شده است؛ با هشتگ موضوعی یا لینک مستقیم وارد پست شوید.
        </p>
      </div>

      <a
        href={SITE_CONFIG.eitaaHub.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <span>عضویت در کانال ایتا</span>
        <svg class="h-4 w-4 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
      {product.tutorials.map((tut) => (
        <article class="card-surface flex flex-col justify-between rounded-2xl border border-border bg-card p-5">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex flex-wrap items-center gap-1.5">
                <span dir="ltr" class="inline-block rounded-md bg-muted px-2 py-0.5 font-mono text-[11px] font-semibold text-primary">
                  {product.eitaaProductHashtag}
                </span>
                <span dir="ltr" class="inline-block rounded-md bg-muted px-2 py-0.5 font-mono text-[11px] text-foreground">
                  {tut.hashtag}
                </span>
              </div>
              <span class="rounded-md bg-muted px-2 py-0.5 text-xs font-semibold text-muted-foreground tabular-nums">
                {tut.duration}
              </span>
            </div>

            <h3 class="mt-3 text-base font-bold leading-snug text-foreground text-balance">
              {tut.title}
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground sm:text-sm text-pretty">
              {tut.summary}
            </p>
          </div>

          <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-border pt-3.5">
            <a
              href={tut.postUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded sm:text-sm"
            >
              <span>مشاهده پست آموزش در ایتا</span>
              <svg class="h-3.5 w-3.5 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>

            <button
              type="button"
              data-copy-hashtag={tut.hashtag}
              class="inline-flex min-w-[110px] items-center justify-center rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              کپی هشتگ
            </button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function bindHashtagCopy() {
      var buttons = document.querySelectorAll('[data-copy-hashtag]');
      buttons.forEach(function (btn) {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', function () {
          var tag = btn.getAttribute('data-copy-hashtag');
          if (!tag || !navigator.clipboard) return;
          navigator.clipboard.writeText(tag).then(function () {
            var prev = btn.textContent;
            btn.textContent = 'کپی شد';
            setTimeout(function () {
              btn.textContent = prev;
            }, 1800);
          }).catch(function () {});
        });
      });
    }
    bindHashtagCopy();
    document.addEventListener('astro:after-swap', bindHashtagCopy);
  })();
</script>
