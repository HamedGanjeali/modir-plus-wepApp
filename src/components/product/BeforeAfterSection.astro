---
import type { ProductDefinition } from '../../data/products';

interface Props {
  product: ProductDefinition;
}

const { product } = Astro.props;
const isPrimary = product.accentTone === 'primary';
---

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
  <div class="max-w-2xl">
    <span
      class:list={[
        'inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold',
        isPrimary
          ? 'border-primary/25 bg-primary/10 text-primary'
          : 'border-success/25 bg-success/10 text-success',
      ]}
    >
      مقایسه روش دستی و {product.name}
    </span>
    <h2 class="mt-2.5 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl text-balance">
      تفاوت عملی در کارهای روزمره دفتر مدرسه
    </h2>
  </div>

  <div class="mt-7 grid grid-cols-1 gap-4 lg:grid-cols-3">
    {product.beforeAfter.map((item, idx) => (
      <article class="card-surface flex flex-col justify-between rounded-2xl border border-border bg-card p-5">
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="rounded-lg bg-muted px-2.5 py-1 text-xs font-bold text-foreground tabular-nums">
              سناریو {idx + 1 === 1 ? '۱' : idx + 1 === 2 ? '۲' : '۳'}
            </span>
          </div>
          <h3 class="mt-3 text-base font-bold leading-snug text-foreground text-balance">
            {item.task}
          </h3>
        </div>

        <div class="mt-4 space-y-2.5">
          <div class="rounded-xl border border-warning/25 bg-warning/8 p-3">
            <p class="text-[11px] font-bold text-warning">روش دستی فعلی</p>
            <p class="mt-1 text-xs leading-relaxed text-muted-foreground text-pretty">
              {item.before}
            </p>
          </div>

          <div
            class:list={[
              'rounded-xl border p-3',
              isPrimary
                ? 'border-primary/25 bg-primary/8'
                : 'border-success/25 bg-success/8',
            ]}
          >
            <p
              class:list={[
                'text-[11px] font-bold',
                isPrimary ? 'text-primary' : 'text-success',
              ]}
            >
              با {product.name}
            </p>
            <p class="mt-1 text-xs leading-relaxed text-foreground text-pretty">
              {item.after}
            </p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
