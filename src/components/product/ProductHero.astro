---
import type { ProductDefinition } from '../../data/products';
import { SITE_CONFIG } from '../../data/site';
import ProductMiniMock from '../landing/ProductMiniMock.astro';

interface Props {
  product: ProductDefinition;
}

const { product } = Astro.props;
const isPrimary = product.accentTone === 'primary';
---

<section class="relative overflow-hidden border-b border-border/80 pt-8 pb-12 lg:pt-10 lg:pb-16">
  <div
    class="bg-dot-grid pointer-events-none absolute inset-0 opacity-55 [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"
    aria-hidden="true"
  />
  <div
    class:list={[
      'pointer-events-none absolute -top-24 start-1/4 h-72 w-72 rounded-full blur-3xl',
      isPrimary ? 'bg-primary/12' : 'bg-success/12',
    ]}
    aria-hidden="true"
  />

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <nav aria-label="مسیر صفحه" class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
      <a
        href="/"
        class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded"
      >
        خانه
      </a>
      <span aria-hidden="true">/</span>
      <a
        href="/#products"
        class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded"
      >
        محصولات
      </a>
      <span aria-hidden="true">/</span>
      <span class="font-semibold text-foreground">{product.name}</span>
    </nav>

    <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
      <div class="min-w-0 lg:col-span-6">
        <div class="flex flex-wrap items-center gap-2">
          <span
            class:list={[
              'rounded-full border px-3 py-1 text-xs font-semibold tabular-nums',
              isPrimary
                ? 'border-primary/25 bg-primary/10 text-primary'
                : 'border-success/25 bg-success/10 text-success',
            ]}
          >
            نسخه {product.version}
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-success/30 bg-success/10 px-3 py-1 text-xs font-semibold text-success">
            <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true" />
            {SITE_CONFIG.trialPolicy.badgeLabel}
          </span>
        </div>

        <h1
          transition:name={`product-title-${product.slug}`}
          class="mt-4 text-3xl font-extrabold leading-[1.3] tracking-tight text-foreground sm:text-4xl lg:text-[2.6rem] text-balance"
        >
          {product.name}
        </h1>

        <p class="mt-2 text-sm font-semibold text-primary sm:text-base">
          {product.categoryLabel}
        </p>

        <p class="mt-3 max-w-prose text-sm leading-[1.85] text-muted-foreground sm:text-base text-pretty">
          {product.heroSummary}
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-1.5">
          <span class="text-xs font-medium text-muted-foreground">مخاطبان:</span>
          {product.targetRoles.map((role) => (
            <span class="rounded-lg border border-border bg-card px-2.5 py-1 text-xs font-medium text-foreground">
              {role}
            </span>
          ))}
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="#install-box"
            class:list={[
              'inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background',
              isPrimary ? 'bg-primary' : 'bg-success',
            ]}
          >
            <span>دانلود و نصب افزونه</span>
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <a
            href={product.baleBotUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-card px-4 py-3 text-sm font-semibold text-foreground transition-colors hover:border-primary/45 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            <span>شروع ۱۰ روز تست رایگان</span>
            <span dir="ltr" class="font-mono text-xs text-primary">{product.baleBotHandle}</span>
          </a>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-4 text-xs font-medium text-muted-foreground">
          <a
            href="#gallery"
            class="inline-flex items-center gap-1 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded"
          >
            <span>مشاهده پیش‌نمایش‌ها</span>
            <svg class="h-3.5 w-3.5 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <span class="text-border" aria-hidden="true">|</span>
          <a
            href="#eitaa-tutorials"
            class="inline-flex items-center gap-1 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded"
          >
            <span>آموزش‌های لقمه‌ای در ایتا</span>
            <span dir="ltr" class="font-mono text-primary">{product.eitaaProductHashtag}</span>
          </a>
        </div>
      </div>

      <div class="min-w-0 lg:col-span-6">
        <div class="card-surface rounded-3xl border border-border bg-card p-3 sm:p-4">
          <ProductMiniMock slug={product.slug} />
          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 px-1 text-xs text-muted-foreground">
            <span>نمای محیط واقعی {product.name} با داده‌های نمونه</span>
            <span class="rounded-md bg-muted px-2 py-0.5 font-medium text-foreground tabular-nums">
              ویدیوی نصب: {product.installVideoDuration}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
