---
import { SITE_CONFIG } from '../../data/site';
import { PRODUCTS } from '../../data/products';
import ProductMiniMock from './ProductMiniMock.astro';
---

<section class="relative overflow-hidden pt-10 pb-14 lg:pt-16 lg:pb-20">
  <div
    class="bg-dot-grid pointer-events-none absolute inset-0 opacity-55 [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute -top-24 start-1/4 h-72 w-72 rounded-full bg-primary/12 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute top-12 end-1/4 h-64 w-64 rounded-full bg-success/10 blur-3xl"
    aria-hidden="true"
  />

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-border/80 bg-card/90 px-3.5 py-1.5 text-xs font-medium text-foreground shadow-xs backdrop-blur-md">
        <span class="h-2 w-2 shrink-0 rounded-full bg-success" aria-hidden="true" />
        <span class="truncate">{SITE_CONFIG.trialPolicy.badgeLabel}</span>
      </div>

      <h1 class="mt-6 text-3xl font-bold leading-[1.35] text-foreground sm:text-4xl lg:text-[2.65rem] text-balance">
        مدیریت یکپارچه <span class="text-primary">سیدا</span>، <span class="text-primary">برنامه هفتگی</span> و <span class="text-success">کارنامه مدارس</span>
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-sm leading-[1.9] text-muted-foreground sm:text-base text-pretty">
        {SITE_CONFIG.heroDescription}
      </p>

      <div class="mt-5 flex items-center justify-center">
        <a
          href="#decision-matrix"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded-md"
        >
          <span>کدام ابزار مناسب کار امروز شماست؟</span>
          <svg class="h-3.5 w-3.5 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>

    <div id="products" class="scroll-mt-24 mt-11 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-7">
      {PRODUCTS.map((product) => {
        const isPrimary = product.accentTone === 'primary';
        const gateway = SITE_CONFIG.gatewayCards[product.slug];

        return (
          <article
            class:list={[
              'card-surface group relative flex flex-col justify-between overflow-hidden rounded-3xl border bg-card p-4 transition-colors duration-300 sm:p-7',
              isPrimary
                ? 'border-border hover:border-primary/45'
                : 'border-border hover:border-success/45',
            ]}
          >
            <div
              class:list={[
                'pointer-events-none absolute -top-20 end-0 -me-12 h-44 w-44 rounded-full blur-3xl transition-opacity duration-300 group-hover:opacity-90',
                isPrimary ? 'bg-primary/12' : 'bg-success/12',
              ]}
              aria-hidden="true"
            />

            <div class="relative">
              <div class="flex items-start justify-between gap-2.5">
                <div class="flex min-w-0 items-center gap-2.5 sm:gap-3">
                  <span
                    class:list={[
                      'flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-sm font-extrabold',
                      isPrimary ? 'bg-primary/12 text-primary' : 'bg-success/12 text-success',
                    ]}
                    aria-hidden="true"
                  >
                    {isPrimary ? 'س' : 'ک'}
                  </span>
                  <div class="min-w-0">
                    <h2
                      transition:name={`product-title-${product.slug}`}
                      class="text-xl font-extrabold text-foreground sm:text-2xl"
                    >
                      <a
                        href={`/products/${product.slug}`}
                        class="hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded-lg"
                      >
                        {product.name}
                      </a>
                    </h2>
                    <p class="mt-0.5 text-xs leading-snug text-muted-foreground">{gateway.roleBadge}</p>
                  </div>
                </div>

                <span
                  class:list={[
                    'shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold',
                    isPrimary ? 'bg-primary/10 text-primary' : 'bg-success/10 text-success',
                  ]}
                >
                  {isPrimary ? 'سیدا و شاد' : 'نمره و کارنامه'}
                </span>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-muted-foreground text-pretty">
                {product.shortTagline}
              </p>

              <a
                href={`/products/${product.slug}`}
                aria-label={`باز کردن صفحه اختصاصی ${product.name}`}
                class="mt-5 block rounded-2xl transition-transform duration-300 group-hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card"
              >
                <ProductMiniMock slug={product.slug} />
              </a>
            </div>

            <div class="relative mt-5 flex flex-col items-stretch gap-2.5 border-t border-border/80 pt-4 sm:mt-6 sm:flex-row sm:items-center sm:justify-between sm:gap-3 sm:pt-5">
              <a
                href={`/products/${product.slug}`}
                class:list={[
                  'inline-flex items-center justify-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card',
                  isPrimary ? 'bg-primary' : 'bg-success',
                ]}
              >
                <span>مشاهده و نصب {product.name}</span>
                <svg class="h-4 w-4 shrink-0 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>

              <a
                href={product.baleBotUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 rounded-lg px-2 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              >
                <span>۱۰ روز تست در بله</span>
                <svg class="h-3.5 w-3.5 shrink-0 rtl:-scale-x-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M7 17 17 7M7 7h10v10" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
