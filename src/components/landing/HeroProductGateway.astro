---
import { SITE_CONFIG } from '../../data/site';
import { PRODUCTS } from '../../data/products';
import ProductMiniMock from './ProductMiniMock.astro';
---

<section class="relative overflow-hidden pt-10 pb-14 lg:pt-14 lg:pb-16">
  <div
    class="bg-dot-grid pointer-events-none absolute inset-0 opacity-60 [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute -top-24 start-1/4 h-72 w-72 rounded-full bg-primary/12 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute top-12 end-1/4 h-64 w-64 rounded-full bg-success/10 blur-3xl"
    aria-hidden="true"
  />

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-success/30 bg-success/10 px-3.5 py-1.5 text-xs font-semibold text-success">
        <span class="h-2 w-2 shrink-0 rounded-full bg-success" aria-hidden="true" />
        <span class="truncate">{SITE_CONFIG.trialPolicy.badgeLabel}</span>
      </div>

      <h1 class="mt-4 text-3xl font-extrabold leading-[1.3] tracking-tight text-foreground sm:text-4xl lg:text-[2.75rem] text-balance">
        {SITE_CONFIG.heroHeadline}
      </h1>

      <p class="mx-auto mt-3.5 max-w-2xl text-sm leading-[1.85] text-muted-foreground sm:text-base text-pretty">
        {SITE_CONFIG.heroDescription}
      </p>

      <div class="mt-5 flex flex-wrap items-center justify-center gap-4 text-xs font-semibold">
        <a
          href="#decision-matrix"
          class="inline-flex items-center gap-1.5 text-primary transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded-md"
        >
          <span>راهنمای انتخاب ۵ ثانیه‌ای بین دو ابزار</span>
          <svg class="h-3.5 w-3.5 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <span class="text-border" aria-hidden="true">|</span>
        <a
          href="#eitaa-hub"
          class="inline-flex items-center gap-1.5 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded-md"
        >
          <span>ویدیوهای آموزشی ایتا</span>
        </a>
      </div>
    </div>

    <div id="products" class="scroll-mt-24 mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
      {PRODUCTS.map((product) => {
        const isPrimary = product.accentTone === 'primary';
        const gateway = SITE_CONFIG.gatewayCards[product.slug];

        return (
          <article
            class:list={[
              'card-surface group relative flex flex-col justify-between overflow-hidden rounded-3xl border bg-card p-5 transition-colors duration-300 sm:p-6',
              isPrimary
                ? 'border-border hover:border-primary/50'
                : 'border-border hover:border-success/50',
            ]}
          >
            <div
              class:list={[
                'pointer-events-none absolute -top-20 end-0 -me-12 h-44 w-44 rounded-full blur-3xl transition-opacity duration-300 group-hover:opacity-90',
                isPrimary ? 'bg-primary/12' : 'bg-success/12',
              ]}
              aria-hidden="true"
            />

            <div class="relative">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex min-w-0 items-center gap-2.5">
                  <span
                    class:list={[
                      'flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-sm font-extrabold',
                      isPrimary ? 'bg-primary/12 text-primary' : 'bg-success/12 text-success',
                    ]}
                    aria-hidden="true"
                  >
                    {isPrimary ? 'س' : 'ک'}
                  </span>
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <h2
                        transition:name={`product-title-${product.slug}`}
                        class="text-xl font-extrabold text-foreground sm:text-2xl"
                      >
                        <a
                          href={`/products/${product.slug}`}
                          class="hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded-lg"
                        >
                          {product.name}
                        </a>
                      </h2>
                      <span class="rounded-md border border-border bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground tabular-nums">
                        {product.version}
                      </span>
                    </div>
                    <p class="truncate text-xs text-muted-foreground">{gateway.roleBadge}</p>
                  </div>
                </div>

                <span
                  class:list={[
                    'rounded-full px-2.5 py-1 text-[11px] font-semibold',
                    isPrimary ? 'bg-primary/10 text-primary' : 'bg-success/10 text-success',
                  ]}
                >
                  {isPrimary ? 'اتوماسیون سیدا و شاد' : 'نمره، حضورغیاب و کارنامه'}
                </span>
              </div>

              <p class="mt-3.5 text-sm leading-relaxed text-muted-foreground text-pretty">
                {product.shortTagline}
              </p>

              <a
                href={`/products/${product.slug}`}
                aria-label={`باز کردن صفحه اختصاصی ${product.name}`}
                class="mt-4 block rounded-2xl transition-transform duration-300 group-hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card"
              >
                <ProductMiniMock slug={product.slug} />
              </a>

              <ul class="mt-4 space-y-2 text-sm text-foreground/90">
                {gateway.conciseBullets.map((bullet) => (
                  <li class="flex items-start gap-2">
                    <svg
                      class:list={[
                        'mt-1 h-4 w-4 shrink-0',
                        isPrimary ? 'text-primary' : 'text-success',
                      ]}
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="leading-snug">{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="relative mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-4">
              <a
                href={`/products/${product.slug}`}
                class:list={[
                  'inline-flex flex-1 items-center justify-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card sm:flex-initial',
                  isPrimary ? 'bg-primary' : 'bg-success',
                ]}
              >
                <span>ورود به صفحه محصول و دانلود</span>
                <svg class="h-4 w-4 shrink-0 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>

              <a
                href={product.baleBotUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              >
                <span>تست در بله</span>
                <span dir="ltr" class="font-mono text-[11px] text-muted-foreground">{product.baleBotHandle}</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
