---
import { SITE_CONFIG } from '../../data/site';
import { PRODUCTS } from '../../data/products';

const workflowSteps = [
  { step: '۱', title: 'نصب روی مرورگر مدرسه', detail: 'کروم، اج یا فایرفاکس' },
  { step: '۲', title: 'آموزش کوتاه در ایتا', detail: 'ویدیوهای ۳۰ تا ۶۰ ثانیه‌ای' },
  { step: '۳', title: 'فعال‌سازی تست در بله', detail: '۱۰ روز رایگان بدون حذف داده' },
] as const;

const productCapabilitiesBySlug: Record<string, string[]> = {
  'sida-plus': ['دفتر آمار و امتحانات', 'برنامه هفتگی بدون تداخل', 'مدیریت گروه‌های شاد'],
  'karnameh-plus': ['پورتال ثبت نمره دبیر', 'حضورغیاب ۶ زنگی معاون', 'کارنامه آنلاین اولیا'],
};
---

<section class="relative overflow-hidden border-b border-border/70">
  <div
    class="pointer-events-none absolute -top-24 start-1/4 h-72 w-72 rounded-full bg-primary/10 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute -bottom-24 end-1/6 h-64 w-64 rounded-full bg-success/10 blur-3xl"
    aria-hidden="true"
  />

  <div class="relative mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 py-12 sm:px-6 lg:grid-cols-12 lg:items-center lg:gap-12 lg:px-8 lg:py-16">
    <div class="min-w-0 lg:col-span-6">
      <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-success/30 bg-success/10 px-3.5 py-1.5 text-xs font-semibold text-success">
        <span class="h-2 w-2 shrink-0 rounded-full bg-success" aria-hidden="true" />
        <span class="truncate">{SITE_CONFIG.trialPolicy.badgeLabel}</span>
      </div>

      <h1 class="mt-5 text-3xl font-extrabold leading-[1.3] tracking-tight text-foreground sm:text-4xl lg:text-[2.65rem] text-balance">
        {SITE_CONFIG.heroHeadline}
      </h1>

      <p class="mt-4 max-w-prose text-base leading-[1.85] text-muted-foreground sm:text-lg text-pretty">
        {SITE_CONFIG.heroDescription}
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3.5">
        <a
          href="#products"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <span>مشاهده و مقایسه محصولات</span>
          <svg class="h-4 w-4 shrink-0 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <a
          href="#eitaa-hub"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-card px-5 py-3 text-sm font-medium text-foreground transition-colors hover:border-primary/40 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <svg class="h-4 w-4 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <polygon points="6 3 20 12 6 21 6 3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>آشنایی با هاب آموزشی ایتا</span>
        </a>
      </div>

      <dl class="mt-9 grid grid-cols-1 gap-3 border-t border-border pt-6 sm:grid-cols-3">
        {SITE_CONFIG.heroMetrics.map((metric) => (
          <div class="rounded-2xl border border-border/80 bg-card/80 px-4 py-3">
            <dt class="text-xs text-muted-foreground">{metric.label}</dt>
            <dd class="mt-1 text-lg font-bold text-foreground tabular-nums">{metric.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="min-w-0 lg:col-span-6">
      <div
        aria-label="نمای خلاصه وضعیت ابزارهای اکوسیستم مدیر پلاس"
        class="flex min-h-[370px] flex-col justify-between rounded-3xl border border-border bg-card/95 p-5 shadow-sm backdrop-blur-md sm:p-6"
      >
        <div>
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border pb-4">
            <div class="flex min-w-0 items-center gap-2.5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" rx="1.5" />
                  <rect x="14" y="3" width="7" height="7" rx="1.5" />
                  <rect x="3" y="14" width="7" height="7" rx="1.5" />
                  <rect x="14" y="14" width="7" height="7" rx="1.5" />
                </svg>
              </span>
              <div class="min-w-0">
                <p class="truncate text-sm font-bold text-foreground">وضعیت ابزارهای {SITE_CONFIG.brandName}</p>
                <p dir="ltr" class="truncate text-start font-mono text-xs text-muted-foreground">{SITE_CONFIG.domain}</p>
              </div>
            </div>

            <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-success/30 bg-success/10 px-2.5 py-1 text-xs font-medium text-success">
              <span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true" />
              آماده نصب در مدارس
            </span>
          </div>

          <div class="mt-4 space-y-3">
            {PRODUCTS.map((product) => {
              const isPrimary = product.accentTone === 'primary';
              const capabilities = productCapabilitiesBySlug[product.slug] ?? [];
              return (
                <a
                  href={`/products/${product.slug}`}
                  class="group block rounded-2xl border border-border bg-background/70 p-4 transition-colors hover:border-primary/45 hover:bg-muted/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                >
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex min-w-0 items-center gap-2.5">
                      <span
                        class:list={[
                          'inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-xs font-bold',
                          isPrimary ? 'bg-primary/15 text-primary' : 'bg-success/15 text-success',
                        ]}
                        aria-hidden="true"
                      >
                        {isPrimary ? 'س' : 'ک'}
                      </span>
                      <div class="min-w-0">
                        <div class="flex items-center gap-2">
                          <span class="text-sm font-bold text-foreground group-hover:text-primary">{product.name}</span>
                          <span class="rounded-md bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground tabular-nums">
                            نسخه {product.version}
                          </span>
                        </div>
                      </div>
                    </div>

                    <span
                      dir="ltr"
                      class="inline-block font-mono text-[11px] text-muted-foreground group-hover:text-foreground"
                    >
                      {product.baleBotHandle}
                    </span>
                  </div>

                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {capabilities.map((cap) => (
                      <span class="rounded-lg border border-border/80 bg-card px-2.5 py-1 text-xs text-muted-foreground">
                        {cap}
                      </span>
                    ))}
                  </div>
                </a>
              );
            })}
          </div>
        </div>

        <div class="mt-4 rounded-2xl border border-border/80 bg-muted/60 p-3.5">
          <p class="text-xs font-semibold text-foreground">مسیر شروع در دفتر مدرسه:</p>
          <ol class="mt-2.5 grid grid-cols-1 gap-2 sm:grid-cols-3">
            {workflowSteps.map((item) => (
              <li class="flex items-start gap-2 rounded-xl bg-card/80 px-2.5 py-2">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15 text-[11px] font-bold text-primary tabular-nums">
                  {item.step}
                </span>
                <div class="min-w-0">
                  <p class="text-xs font-semibold text-foreground">{item.title}</p>
                  <p class="text-[11px] text-muted-foreground">{item.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>
