---
import { SITE_CONFIG } from '../../data/site';
import { PRODUCTS } from '../../data/products';
import { FaqAccordion } from '../FaqAccordion';

const { eyebrow, title, pillars, tutorialTags } = SITE_CONFIG.trustSection;
---

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
  <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
    <div>
      <span class="inline-flex items-center rounded-full border border-success/30 bg-success/10 px-3 py-1 text-xs font-semibold text-success">
        {eyebrow}
      </span>
      <h2 class="mt-2.5 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl text-balance">
        {title}
      </h2>
    </div>

    <a
      href="/guide"
      class="inline-flex shrink-0 items-center gap-1.5 text-xs font-semibold text-primary hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded sm:text-sm"
    >
      <span>راهنمای کامل نصب و حریم خصوصی</span>
      <svg class="h-4 w-4 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>

  <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {pillars.map((pillar) => (
      <article class="card-surface rounded-2xl border border-border bg-card p-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
            {pillar.id === 'privacy' && (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {pillar.id === 'safety' && (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {pillar.id === 'browsers' && (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
              </svg>
            )}
            {pillar.id === 'trial' && (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </div>
          <h3 class="text-sm font-bold text-foreground">{pillar.title}</h3>
        </div>
        <p class="mt-2.5 text-xs leading-[1.75] text-muted-foreground text-pretty">{pillar.description}</p>
      </article>
    ))}
  </div>

  <div
    id="eitaa-hub"
    class="card-surface scroll-mt-24 mt-8 rounded-3xl border border-border bg-card p-5 sm:p-7"
  >
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-center">
      <div class="min-w-0 lg:col-span-7">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-primary/25 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
            هاب آموزشی یکپارچه ایتا
          </span>
          <span dir="ltr" class="inline-block rounded-full bg-muted px-3 py-1 font-mono text-xs text-muted-foreground">
            {SITE_CONFIG.eitaaHub.handle}
          </span>
        </div>

        <h3 class="mt-3 text-xl font-extrabold text-foreground text-balance">
          {SITE_CONFIG.eitaaHub.name}
        </h3>
        <p class="mt-1.5 max-w-prose text-sm leading-[1.8] text-muted-foreground text-pretty">
          {SITE_CONFIG.eitaaHub.description}
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a
            href={SITE_CONFIG.eitaaHub.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:text-sm"
          >
            <span>عضویت در کانال ایتا</span>
            <svg class="h-4 w-4 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          {PRODUCTS.map((product) => (
            <a
              href={product.baleBotUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3 py-2 text-xs font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              <span>بله {product.name}</span>
              <span dir="ltr" class="font-mono text-[11px] text-primary">{product.baleBotHandle}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="min-w-0 lg:col-span-5">
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-1">
          {tutorialTags.map((item) => (
            <a
              href={`/products/${item.productSlug}`}
              class="flex min-w-0 items-center justify-between gap-3 rounded-xl border border-border bg-muted/45 px-3.5 py-2 transition-colors hover:border-primary/40 hover:bg-card focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              <div class="flex min-w-0 flex-wrap items-center gap-2">
                <span dir="ltr" class="inline-block text-xs font-semibold text-primary">{item.hashtag}</span>
                <span dir="ltr" class="inline-block text-xs text-foreground">{item.topic}</span>
              </div>
              <span class="shrink-0 rounded-md bg-card px-2 py-0.5 text-[11px] font-medium text-muted-foreground tabular-nums">
                {item.duration}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-4">
      <span class="text-xs font-semibold text-primary">پاسخ کوتاه و شفاف</span>
      <h3 class="mt-1.5 text-xl font-extrabold text-foreground sm:text-2xl text-balance">
        سوالات پرتکرار مدیران
      </h3>
      <p class="mt-1.5 text-sm leading-[1.75] text-muted-foreground text-pretty">
        پاسخ‌های فنی هر محصول در صفحه اختصاصی خودش و صفحه راهنمای نصب نیز موجود است.
      </p>
    </div>

    <div class="lg:col-span-8">
      <FaqAccordion items={SITE_CONFIG.homeFaqs} client:visible />
    </div>
  </div>
</section>
