---
interface Props {
  slug: 'sida-plus' | 'karnameh-plus';
}

const { slug } = Astro.props;

const sidaModules = [
  { label: 'عملیات سیدا', active: true },
  { label: 'برنامه هفتگی', active: false },
  { label: 'گروه‌های شاد', active: false },
] as const;

const sidaTimetableCells = [
  { day: 'شنبه • ۱', text: 'ریاضی ۷۰۱' },
  { day: 'شنبه • ۲', text: 'علوم ۸۰۲' },
  { day: 'یکشنبه • ۱', text: 'ادبیات ۹۰۱' },
  { day: 'یکشنبه • ۲', text: 'عربی ۷۰۱' },
] as const;

const bells = [
  { num: '۱', ok: true },
  { num: '۲', ok: true },
  { num: '۳', ok: false },
  { num: '۴', ok: true },
  { num: '۵', ok: true },
  { num: '۶', ok: true },
] as const;
---

<div
  transition:name={`product-preview-${slug}`}
  class="relative aspect-[16/10] w-full overflow-hidden rounded-2xl border border-border bg-muted/65 p-2.5 sm:p-3.5"
>
  <div
    class:list={[
      'pointer-events-none absolute -top-10 start-1/2 h-28 w-44 -translate-x-1/2 rounded-full blur-2xl',
      slug === 'sida-plus' ? 'bg-primary/20' : 'bg-success/20',
    ]}
    aria-hidden="true"
  />

  {slug === 'sida-plus' ? (
    <div class="relative flex h-full flex-col justify-between gap-2.5">
      <div class="flex items-center justify-between gap-2 rounded-xl border border-border bg-card px-3 py-1.5 shadow-xs">
        <div class="flex min-w-0 items-center gap-2">
          <div class="flex items-center gap-1" aria-hidden="true">
            <span class="h-2 w-2 rounded-full bg-border" />
            <span class="h-2 w-2 rounded-full bg-border" />
            <span class="h-2 w-2 rounded-full bg-primary" />
          </div>
          <span dir="ltr" class="truncate font-mono text-[10px] text-muted-foreground">sida.medu.ir</span>
        </div>
        <span class="shrink-0 rounded-md bg-primary/12 px-2 py-0.5 text-[10px] font-semibold text-primary tabular-nums">
          سایدبار سیدا پلاس ۲.۵.۰
        </span>
      </div>

      <div class="grid min-h-0 flex-1 grid-cols-12 gap-2.5">
        <div class="card-surface col-span-5 flex flex-col justify-between rounded-xl border border-border bg-card p-2.5">
          <div class="space-y-1">
            {sidaModules.map((mod) => (
              <div
                class:list={[
                  'rounded-lg px-2 py-1 text-[10px] font-semibold',
                  mod.active ? 'bg-primary text-primary-foreground shadow-xs' : 'bg-muted/70 text-muted-foreground',
                ]}
              >
                {mod.label}
              </div>
            ))}
          </div>

          <div class="space-y-1 border-t border-border pt-1.5">
            <div class="flex items-center justify-between gap-1 rounded-md bg-muted/70 px-1.5 py-1 text-[8px] text-foreground sm:px-2 sm:text-[9px]">
              <span class="truncate">دفتر آمار</span>
              <span class="shrink-0 font-semibold text-success tabular-nums">۲۰۰ ص</span>
            </div>
            <div class="flex items-center justify-between gap-1 rounded-md bg-muted/70 px-1.5 py-1 text-[8px] text-foreground sm:px-2 sm:text-[9px]">
              <span class="truncate">لینک شاد</span>
              <span class="shrink-0 font-semibold text-primary tabular-nums">۳۵۰+</span>
            </div>
          </div>
        </div>

        <div class="card-surface col-span-7 flex flex-col justify-between rounded-xl border border-border bg-card p-2 sm:p-2.5">
          <div class="flex items-center justify-between gap-1">
            <span class="truncate text-[9px] font-bold text-foreground sm:text-[10px]">برنامه هفتگی</span>
            <span class="shrink-0 rounded-full bg-success/15 px-1.5 py-0.5 text-[8px] font-semibold text-success tabular-nums sm:px-2 sm:text-[9px]">
              ۰ تداخل
            </span>
          </div>

          <div class="grid grid-cols-2 gap-1 sm:gap-1.5">
            {sidaTimetableCells.map((cell) => (
              <div class="rounded-lg border border-border/80 bg-muted/45 px-1.5 py-1 sm:px-2">
                <p class="text-[8px] text-muted-foreground tabular-nums">{cell.day}</p>
                <p class="truncate text-[8px] font-semibold text-foreground tabular-nums sm:text-[9px]">{cell.text}</p>
              </div>
            ))}
          </div>

          <div class="flex items-center justify-between gap-1 rounded-lg border border-primary/20 bg-primary/10 px-1.5 py-1 text-[8px] font-semibold text-primary sm:px-2 sm:text-[9px]">
            <span class="truncate">۳ سناریو + چاپ A4</span>
            <span class="shrink-0">اکسل</span>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class="relative flex h-full flex-col justify-between gap-2.5">
      <div class="flex items-center justify-between gap-2 rounded-xl border border-border bg-card px-3 py-1.5 shadow-xs">
        <div class="flex min-w-0 items-center gap-2">
          <span class="h-2 w-2 shrink-0 rounded-full bg-success" aria-hidden="true" />
          <span class="truncate text-[10px] font-bold text-foreground">داشبورد مدیر — کارنامه پلاس</span>
        </div>
        <span class="shrink-0 rounded-md bg-success/12 px-2 py-0.5 text-[10px] font-semibold text-success">
          ذخیره آفلاین فعال
        </span>
      </div>

      <div class="grid min-h-0 flex-1 grid-cols-12 gap-2.5">
        <div class="card-surface col-span-6 flex flex-col justify-between rounded-xl border border-border bg-card p-2.5">
          <div>
            <div class="flex items-center justify-between text-[10px]">
              <span class="font-medium text-muted-foreground">تکمیل نمرات</span>
              <span class="font-bold text-success tabular-nums">۹۴٪</span>
            </div>
            <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
              <div class="h-full w-[94%] rounded-full bg-success" />
            </div>
          </div>

          <div>
            <p class="text-[9px] font-medium text-muted-foreground">حضورغیاب ۶ زنگی امروز</p>
            <div class="mt-1.5 grid grid-cols-6 gap-1">
              {bells.map((b) => (
                <span
                  class:list={[
                    'flex h-5 items-center justify-center rounded text-[9px] font-bold tabular-nums',
                    b.ok ? 'bg-success/15 text-success' : 'bg-warning/20 text-warning',
                  ]}
                >
                  {b.num}
                </span>
              ))}
            </div>
          </div>

          <div class="flex items-center justify-between gap-1 text-[9px] font-medium">
            <span class="rounded-md bg-muted px-1.5 py-0.5 text-muted-foreground">دبیران</span>
            <span class="rounded-md bg-muted px-1.5 py-0.5 text-muted-foreground">معاونین</span>
            <span class="rounded-md bg-muted px-1.5 py-0.5 text-muted-foreground">اولیا</span>
          </div>
        </div>

        <div class="card-surface col-span-6 flex flex-col justify-between rounded-xl border border-border bg-card p-2.5">
          <div class="min-w-0">
            <p class="truncate text-[10px] font-bold text-foreground">کارنامه نمونه — علی رضایی</p>
            <p class="truncate text-[9px] text-muted-foreground tabular-nums">کلاس ۷۰۱ • دبیرستان آزمایشی</p>
          </div>

          <div class="space-y-1.5">
            <div>
              <div class="flex justify-between text-[9px]">
                <span class="text-foreground">نمره دانش‌آموز</span>
                <span class="font-bold text-success tabular-nums">۱۹.۲۵</span>
              </div>
              <div class="mt-0.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full w-[94%] rounded-full bg-success" />
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[9px]">
                <span class="text-muted-foreground">میانگین کلاس</span>
                <span class="font-semibold text-primary tabular-nums">۱۷.۸۰</span>
              </div>
              <div class="mt-0.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full w-[82%] rounded-full bg-primary" />
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[9px]">
                <span class="text-muted-foreground">میانگین پایه</span>
                <span class="font-medium text-muted-foreground tabular-nums">۱۷.۱۰</span>
              </div>
              <div class="mt-0.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full w-[76%] rounded-full bg-muted-foreground/50" />
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between rounded-lg border border-success/20 bg-success/10 px-2 py-1 text-[9px] font-semibold text-success">
            <span class="truncate">انضباط محاسبه‌شده</span>
            <span class="shrink-0 font-bold tabular-nums">۲۰ / ۲۰</span>
          </div>
        </div>
      </div>
    </div>
  )}
</div>
