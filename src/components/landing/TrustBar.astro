---
---

<section class="border-t border-border/70 bg-card/40 py-8 backdrop-blur-xs">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-8">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-success/10 text-success">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="text-xs font-bold text-foreground sm:text-sm">پردازش محلی و آفلاین</p>
          <p class="mt-0.5 text-[11px] text-muted-foreground sm:text-xs">بدون ذخیره اطلاعات مدرسه و رمز سیدا در سرور</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="text-xs font-bold text-foreground sm:text-sm">۱۰ روز تست رایگان یکپارچه</p>
          <p class="mt-0.5 text-[11px] text-muted-foreground sm:text-xs">دسترسی کامل بدون نیاز به ثبت کارت بانکی</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-warning/10 text-warning">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <div class="min-w-0">
          <p class="text-xs font-bold text-foreground sm:text-sm">آموزش و پشتیبانی مستقیم</p>
          <p class="mt-0.5 text-[11px] text-muted-foreground sm:text-xs">آموزش‌های کوتاه در ایتا و ربات‌های فعال در بله</p>
        </div>
      </div>
    </div>
  </div>
</section>
