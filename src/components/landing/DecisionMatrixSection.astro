---
import { SITE_CONFIG } from '../../data/site';

const { eyebrow, title, subtitle, tracks, quickTaskRows } = SITE_CONFIG.decisionMatrix;
---

<section
  id="decision-matrix"
  class="scroll-mt-24 border-y border-border/70 bg-muted/35 py-14 lg:py-18"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <span class="inline-flex items-center rounded-full border border-primary/25 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary tabular-nums">
        {eyebrow}
      </span>
      <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl text-balance">
        {title}
      </h2>
      <p class="mt-2 max-w-prose text-sm leading-[1.8] text-muted-foreground sm:text-base text-pretty">
        {subtitle}
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {tracks.map((track) => {
        const isPrimary = track.tone === 'primary';
        const isEmerald = track.tone === 'emerald';
        const isCombined = track.tone === 'combined';

        return (
          <article
            class:list={[
              'flex flex-col justify-between rounded-3xl border bg-card p-6 shadow-sm transition-colors',
              isCombined ? 'border-primary/40 ring-1 ring-primary/15' : 'border-border hover:border-primary/40',
            ]}
          >
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span
                  class:list={[
                    'rounded-full px-3 py-1 text-[11px] font-semibold',
                    isPrimary && 'bg-primary/10 text-primary',
                    isEmerald && 'bg-success/10 text-success',
                    isCombined && 'bg-muted text-foreground',
                  ]}
                >
                  {track.badge}
                </span>
              </div>

              <p class="mt-4 text-xs font-medium text-muted-foreground">پیشنهاد برای این نیاز:</p>
              <p
                class:list={[
                  'mt-1 text-lg font-extrabold',
                  isPrimary && 'text-primary',
                  isEmerald && 'text-success',
                  isCombined && 'text-foreground',
                ]}
              >
                {track.recommendedTool}
              </p>

              <h3 class="mt-2 text-lg font-bold leading-snug text-foreground text-balance">
                {track.title}
              </h3>

              <p class="mt-2.5 text-sm leading-[1.75] text-muted-foreground text-pretty">
                {track.summary}
              </p>

              <ul class="mt-5 space-y-2.5 border-t border-border pt-4 text-sm text-foreground/90">
                {track.needs.map((need) => (
                  <li class="flex items-start gap-2.5">
                    <span
                      class:list={[
                        'mt-2 h-1.5 w-1.5 shrink-0 rounded-full',
                        isPrimary && 'bg-primary',
                        isEmerald && 'bg-success',
                        isCombined && 'bg-foreground/70',
                      ]}
                      aria-hidden="true"
                    />
                    <span class="leading-relaxed">{need}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6 border-t border-border pt-4">
              <p class="text-xs text-muted-foreground">
                <span class="font-semibold text-foreground">مخاطبان: </span>
                {track.roles}
              </p>

              <div class="mt-4 flex flex-wrap gap-2.5">
                <a
                  href={track.primaryCtaHref}
                  class:list={[
                    'inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl px-4 py-2.5 text-xs font-semibold transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card sm:text-sm',
                    isEmerald
                      ? 'bg-success text-primary-foreground'
                      : 'bg-primary text-primary-foreground',
                  ]}
                >
                  <span>{track.primaryCtaLabel}</span>
                  <svg class="h-4 w-4 shrink-0 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>

                {track.secondaryCtaHref && track.secondaryCtaLabel && (
                  <a
                    href={track.secondaryCtaHref}
                    class="inline-flex flex-1 items-center justify-center rounded-xl border border-border bg-background px-4 py-2.5 text-xs font-semibold text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:text-sm"
                  >
                    {track.secondaryCtaLabel}
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-10 rounded-3xl border border-border bg-card p-5 sm:p-7">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border pb-4">
        <h3 class="text-base font-bold text-foreground sm:text-lg">
          جدول سریع تطبیق نیاز دفتر مدرسه با ابزار مناسب
        </h3>
        <span class="text-xs text-muted-foreground tabular-nums">۶ سناریوی پرتکرار مدارس</span>
      </div>

      <div class="mt-4 divide-y divide-border">
        {quickTaskRows.map((row) => (
          <div class="grid grid-cols-1 gap-2.5 py-3.5 md:grid-cols-12 md:items-center md:gap-4">
            <p class="min-w-0 text-sm font-medium text-foreground md:col-span-6">
              {row.task}
            </p>
            <p class="text-xs text-muted-foreground md:col-span-3">
              {row.executionMode}
            </p>
            <div class="flex items-center md:col-span-3 md:justify-end">
              <a
                href={row.toolHref}
                class:list={[
                  'inline-flex items-center gap-1.5 rounded-xl border px-3 py-1.5 text-xs font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
                  row.tone === 'primary'
                    ? 'border-primary/25 bg-primary/10 text-primary hover:bg-primary/15'
                    : 'border-success/25 bg-success/10 text-success hover:bg-success/15',
                ]}
              >
                <span>{row.toolName}</span>
                <svg class="h-3.5 w-3.5 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
