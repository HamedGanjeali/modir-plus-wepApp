---
import { PRODUCTS } from '../../data/products';
import { SITE_CONFIG } from '../../data/site';
import ProductMiniMock from './ProductMiniMock.astro';
---

<section id="products" class="scroll-mt-24 mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-18">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <span class="inline-flex items-center rounded-full border border-primary/25 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
        سبد ابزارهای فعال مدیر پلاس
      </span>
      <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl text-balance">
        دو ابزار تخصصی برای اتوماسیون کارهای دفتر مدرسه
      </h2>
      <p class="mt-2 max-w-prose text-sm leading-[1.8] text-muted-foreground sm:text-base text-pretty">
        هر دو محصول با ۱۰ روز تست رایگان، آموزش‌های ویدیویی کوتاه در ایتا و پشتیبانی مستقیم در ربات بله ارائه می‌شوند.
      </p>
    </div>

    <a
      href="#decision-matrix"
      class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-primary transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded-lg"
    >
      <span>مقایسه سریع ۳۰ ثانیه‌ای</span>
      <svg class="h-4 w-4 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-12">
    {PRODUCTS.map((product) => {
      const isPrimary = product.accentTone === 'primary';
      return (
        <article class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-border bg-card p-6 shadow-sm transition-colors duration-300 hover:border-primary/45 sm:p-7 lg:col-span-6">
          <div
            class:list={[
              'pointer-events-none absolute -top-20 end-0 -me-12 h-48 w-48 rounded-full blur-3xl transition-opacity duration-300 group-hover:opacity-90',
              isPrimary ? 'bg-primary/10' : 'bg-success/10',
            ]}
            aria-hidden="true"
          />

          <div class="relative">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-semibold text-muted-foreground tabular-nums">
                نسخه {product.version}
              </span>
              <span
                class:list={[
                  'text-xs font-semibold',
                  isPrimary ? 'text-primary' : 'text-success',
                ]}
              >
                {product.categoryLabel}
              </span>
            </div>

            <div class="mt-4">
              <h3
                transition:name={`product-title-${product.slug}`}
                class="text-2xl font-extrabold text-foreground"
              >
                <a
                  href={`/products/${product.slug}`}
                  class="hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:rounded-lg"
                >
                  {product.name}
                </a>
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground text-pretty">
                {product.shortTagline}
              </p>
            </div>

            <a
              href={`/products/${product.slug}`}
              aria-label={`مشاهده پیش‌نمایش و جزئیات ${product.name}`}
              class="mt-5 block rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card"
            >
              <ProductMiniMock slug={product.slug} />
            </a>

            <div class="mt-5 flex flex-wrap items-center gap-1.5">
              <span class="text-xs font-medium text-muted-foreground">مناسب برای:</span>
              {product.targetRoles.map((role) => (
                <span class="rounded-lg border border-border bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-foreground">
                  {role}
                </span>
              ))}
            </div>

            <ul class="mt-5 space-y-2.5 text-sm leading-relaxed text-foreground/90">
              {product.highlights.map((item) => (
                <li class="flex items-start gap-2.5">
                  <svg
                    class:list={[
                      'mt-1 h-4 w-4 shrink-0',
                      isPrimary ? 'text-primary' : 'text-success',
                    ]}
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="relative mt-7 flex flex-wrap items-center justify-between gap-3 border-t border-border pt-5">
            <div class="flex flex-wrap items-center gap-3">
              <a
                href={`/products/${product.slug}`}
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-card"
              >
                <span>بررسی کامل، تصاویر و دانلود</span>
                <svg class="h-4 w-4 shrink-0 rtl:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>

              <a
                href={product.baleBotUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              >
                ۱۰ روز تست در بله
              </a>
            </div>

            <span dir="ltr" class="inline-block font-mono text-xs text-muted-foreground">
              {product.baleBotHandle}
            </span>
          </div>
        </article>
      );
    })}

    <article class="rounded-3xl border border-dashed border-border bg-card/70 p-6 sm:p-7 lg:col-span-12">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-center">
        <div class="min-w-0 lg:col-span-5">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-warning/30 bg-warning/10 px-3 py-1 text-xs font-semibold text-warning">
            <span class="h-1.5 w-1.5 rounded-full bg-warning" aria-hidden="true" />
            {SITE_CONFIG.upcomingTools.badge}
          </span>
          <h3 class="mt-3 text-xl font-bold text-foreground text-balance">
            {SITE_CONFIG.upcomingTools.title}
          </h3>
          <p class="mt-2 text-sm leading-[1.8] text-muted-foreground text-pretty">
            {SITE_CONFIG.upcomingTools.description}
          </p>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 lg:col-span-5">
          {SITE_CONFIG.upcomingTools.items.map((item) => (
            <div class="rounded-2xl border border-border bg-background/80 p-3.5">
              <p class="text-xs font-bold text-foreground">{item.title}</p>
              <p class="mt-1 text-[11px] text-muted-foreground">{item.targetRole}</p>
              <span class="mt-2.5 inline-block rounded-md bg-muted px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
                در حال توسعه
              </span>
            </div>
          ))}
        </div>

        <div class="flex lg:col-span-2 lg:justify-end">
          <a
            href={SITE_CONFIG.eitaaHub.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center rounded-xl border border-border bg-card px-4 py-2.5 text-center text-xs font-semibold text-foreground transition-colors hover:border-primary/40 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring lg:w-auto"
          >
            اطلاع‌رسانی در ایتا
          </a>
        </div>
      </div>
    </article>
  </div>
</section>
