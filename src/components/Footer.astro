---
import { SITE_CONFIG } from '../data/site';
import { PRODUCTS } from '../data/products';
---

<footer class="border-t border-border bg-card/60">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 py-10 sm:px-6 md:grid-cols-3 lg:px-8">
    <div>
      <div class="flex items-center gap-3">
        <img
          src="/logo.webp"
          alt="لوگوی مدیر پلاس"
          class="h-9 w-9 rounded-lg object-contain shadow-xs"
          width="36"
          height="36"
          loading="lazy"
          decoding="async"
        />
        <p class="text-base font-bold text-foreground">{SITE_CONFIG.brandName}</p>
      </div>
      <p class="mt-2.5 max-w-prose text-sm leading-relaxed text-muted-foreground">
        {SITE_CONFIG.tagline}
      </p>
      <p class="mt-3 text-xs text-muted-foreground">
        {SITE_CONFIG.trialPolicy.summary}
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-foreground">محصولات و دسترسی‌ها</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
        {PRODUCTS.map((product) => (
          <li>
            <a
              href={`/products/${product.slug}`}
              class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              {product.name} (نسخه {product.version})
            </a>
          </li>
        ))}
        <li>
          <a
            href="/guide"
            class="transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            راهنمای نصب و حریم خصوصی
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-foreground">پشتیبانی و آموزش</h2>
      <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
        <li>
          <a
            href={SITE_CONFIG.eitaaHub.url}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-primary"
          >
            {SITE_CONFIG.eitaaHub.name}
          </a>
        </li>
        {PRODUCTS.map((product) => (
          <li>
            <a
              href={product.baleBotUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-primary"
            >
              ربات بله {product.name}:{' '}
              <span dir="ltr" class="inline-block font-mono text-xs">{product.baleBotHandle}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
